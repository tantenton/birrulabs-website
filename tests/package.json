{
  "name": "birrulabs-website-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test",
    "test:a11y": "vitest run --dir tests/unit/accessibility.test.ts",
    "test:perf": "vitest run --dir tests/unit/performance.test.ts",
    "test:security": "vitest run --dir tests/unit/security.test.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitest/coverage-v8": "^2.0.0",
    " axe-core": "^4.10.0",
    "happy-dom": "^15.0.0",
    "jest-axe": "^9.0.0",
    "vitest": "^2.0.0"
  }
}